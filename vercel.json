{
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/tasks.ts": { "includeFiles": "public/study-data/words.json" }
  },
  "crons": [
    { "path": "/api/ranking?settle=1", "schedule": "0 16 * * 6" }
  ],
  "rewrites": [
    { "source": "/api/db-health", "destination": "/api/health?db=1" },
    { "source": "/study", "destination": "/index.html" },
    { "source": "/tasks", "destination": "/index.html" },
    { "source": "/garden", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}

